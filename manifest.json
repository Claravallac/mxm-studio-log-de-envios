{
  "manifest_version": 3,
  "name": "Echoform",
  "version": "3.5.65",
  "description": "Registra envios no MXM Studio com missões, duração, estatísticas, recompensas, Diff Check e backup automático. PT/EN/EL/ID.",
  "author": "nero",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Echoform",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "downloads",
    "identity",
    "notifications"
  ],
  "host_permissions": [
    "https://curators.musixmatch.com/*",
    "https://curators-beta.musixmatch.com/*",
    "https://economia.awesomeapi.com.br/*",
    "https://addons.mozilla.org/*",
    "https://api.github.com/*",
    "https://identitytoolkit.googleapis.com/*",
    "https://securetoken.googleapis.com/*",
    "https://firestore.googleapis.com/*",
    "https://www.googleapis.com/*",
    "https://oauth2.googleapis.com/*",
    "https://is.gd/*",
    "https://itunes.apple.com/*",
    "https://api.deezer.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://curators.musixmatch.com/*",
        "https://curators-beta.musixmatch.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "injected.js",
        "sounds/erro.wav",
        "sounds/atualizacao.wav",
        "sounds/resumo-musica.mp3",
        "sounds/sucesso.mp3",
        "sounds/reenvio.mp3"
      ],
      "matches": [
        "https://curators.musixmatch.com/*",
        "https://curators-beta.musixmatch.com/*"
      ]
    }
  ]
}