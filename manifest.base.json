{
  "manifest_version": 3,
  "name": "Echoform",
  "version": "3.5.66",
  "description": "Registra data/hora de cada envio no MXM Studio, com missão (inclusive manual), duração da faixa, painel de log (foto do curator, atividade por dia/mês, link direto pra página da música), aba Reward (USD+BRL), Diff Check, captura opcional da letra, temas do Tabs V3 (beta), backup completo em .json, backup automático em disco, na nuvem (Firestore) e no Google Drive, importar/exportar, tela de boas-vindas com termos de uso e tour inicial. PT/EN/EL.",
  "author": "nero",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Echoform",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": ["storage", "menus", "downloads", "identity", "notifications"],
  "host_permissions": [
    "https://curators.musixmatch.com/*",
    "https://curators-beta.musixmatch.com/*",
    "https://economia.awesomeapi.com.br/*",
    "https://addons.mozilla.org/*",
    "https://api.github.com/*",
    "https://identitytoolkit.googleapis.com/*",
    "https://securetoken.googleapis.com/*",
    "https://firestore.googleapis.com/*",
    "https://www.googleapis.com/*",
    "https://is.gd/*",
    "https://itunes.apple.com/*",
    "https://api.deezer.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://curators.musixmatch.com/*", "https://curators-beta.musixmatch.com/*"],
      "js": ["i18n/pt.js", "i18n/en.js", "i18n/el.js", "i18n/id.js", "content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "injected.js",
        "sounds/erro.wav",
        "sounds/atualizacao.wav",
        "sounds/resumo-musica.mp3",
        "sounds/sucesso.mp3",
        "sounds/reenvio.mp3"
      ],
      "matches": ["https://curators.musixmatch.com/*", "https://curators-beta.musixmatch.com/*"]
    }
  ]
}
